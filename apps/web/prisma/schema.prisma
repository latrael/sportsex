// sportsex schema v2 (26/27 rebuild — R1.2, R1.3, R1.4, R2.1, R5.7).
//
// Organised into four layers (REBUILD_PLAN_2627.md §"Target architecture"):
//   reference: season · club · club_season · player · player_season · gameweek · fixture
//   events:    player_fixture_stat · player_gameweek_stat · raw_payload  (immutable)
//   derived:   player_season_stat · fair_value                           (recomputed, never incremented)
//   market:    asset · price_tick · trade · position · ledger_entry
//   product:   User · Comment · Friendship · PrivateLeaderboard · Quest · Prediction

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  handle       String    @unique
  passwordHash String?
  coinBalance  Int       @default(10000)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  positions            Position[]
  trades               Trade[]
  ledgerEntries        LedgerEntry[]
  comments             Comment[]
  predictions          Prediction[]
  questCompletions     UserQuest[]
  friendshipsOut       Friendship[]               @relation("friendshipsOut")
  friendshipsIn        Friendship[]               @relation("friendshipsIn")
  privateLeaderboards  PrivateLeaderboard[]
  privateLbMemberships PrivateLeaderboardMember[]
}

model Friendship {
  id        Int      @id @default(autoincrement())
  userId    String
  friendId  String
  status    String // 'pending' | 'accepted'
  createdAt DateTime @default(now())
  user      User     @relation("friendshipsOut", fields: [userId], references: [id])
  friend    User     @relation("friendshipsIn", fields: [friendId], references: [id])

  @@unique([userId, friendId])
}

model PrivateLeaderboard {
  id        Int                        @id @default(autoincrement())
  name      String
  joinCode  String                     @unique
  ownerId   String
  owner     User                       @relation(fields: [ownerId], references: [id])
  createdAt DateTime                   @default(now())
  members   PrivateLeaderboardMember[]
}

model PrivateLeaderboardMember {
  id            Int                @id @default(autoincrement())
  leaderboardId Int
  userId        String
  joinedAt      DateTime           @default(now())
  leaderboard   PrivateLeaderboard @relation(fields: [leaderboardId], references: [id])
  user          User               @relation(fields: [userId], references: [id])

  @@unique([leaderboardId, userId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  playerId  Int?
  clubId    Int?
  player    Player?  @relation(fields: [playerId], references: [id])
  club      Club?    @relation(fields: [clubId], references: [id])
  body      String
  status    String   @default("visible") // visible|hidden|flagged
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
  @@index([clubId, createdAt])
}

model Quest {
  id          Int    @id @default(autoincrement())
  code        String @unique
  title       String
  body        String
  rewardCoins Int
  repeatKind  String // 'daily' | 'weekly' | 'one_shot'

  completions UserQuest[]
}

model UserQuest {
  id          Int      @id @default(autoincrement())
  userId      String
  questId     Int
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  quest       Quest    @relation(fields: [questId], references: [id])

  @@index([userId, completedAt])
}

model Prediction {
  id          Int      @id @default(autoincrement())
  userId      String
  fixtureId   Int
  user        User     @relation(fields: [userId], references: [id])
  fixture     Fixture  @relation(fields: [fixtureId], references: [id])
  pick        String // 'H' | 'D' | 'A'
  coinsStaked Int
  odds        Decimal  @default(2) @db.Decimal(8, 4)
  resolved    Boolean  @default(false)
  payout      Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([fixtureId, resolved])
}

// ---------------------------------------------------------------------------
// Schema v2 — reference tables (TODO_2627.md R1.2, R5.7)
//
// Written only by the FPL ingestion path. Three things drive the shape:
//
// 1. **Identity is stable, membership is season-scoped.** FPL's `element.id`
//    and `team.id` are recycled every season — element 328 is a different
//    footballer in 25/26 than in 26/27. `element.code` / `team.code` and
//    `opta_code` are the stable identifiers, so those key the identity tables
//    (`player`, `club`) while the season-scoped ids live on the membership
//    tables (`player_season`, `club_season`). That mapping is what lets the
//    25/26 backfill be replayed after the August rollover has overwritten
//    FPL's id space (R1.5, R1.7).
// 2. **Zero name-based matching.** No lookup in this path goes through a
//    player or club name; names are payload data, never a key.
// 3. **Nullability follows the data, not the wish.** `squad_number` is null for
//    all 841 players in 25/26, `birth_date` for 19, and
//    `chance_of_playing_next_round` for 211. See R1.2's note in TODO_2627.md.

/// FPL's four element types. Mapped from `element_types[].singular_name_short`
/// at ingest rather than from the numeric id, which is FPL's to renumber.
enum PlayerPosition {
  GKP
  DEF
  MID
  FWD
}

model Season {
  id        Int      @id @default(autoincrement())
  /// "2025/26"
  name      String   @unique
  /// The calendar year the season starts in: 2025 for 2025/26.
  startYear Int      @unique
  createdAt DateTime @default(now())

  clubSeasons   ClubSeason[]
  playerSeasons PlayerSeason[]
  gameweeks     Gameweek[]
  fixtures      Fixture[]

  @@map("season")
}

/// A club's cross-season identity. One row per club, ever.
model Club {
  id        Int    @id @default(autoincrement())
  /// `team.code` — stable across seasons, unlike `team.id`.
  fplCode   Int    @unique
  /// Premier League `pulse_id`, kept as an independent cross-check handle.
  pulseId   Int?
  name      String
  shortName String

  seasons  ClubSeason[]
  comments Comment[]

  @@map("club")
}

/// A club's participation in one season: the season-scoped FPL id and the
/// strength ratings, which are re-derived each season.
model ClubSeason {
  id       Int @id @default(autoincrement())
  seasonId Int
  clubId   Int
  /// `team.id` — 1..20, alphabetical, reassigned every season.
  fplId    Int

  /// Nullable because FPL serves these as null all through preseason — the
  /// strength ratings aren't set until close to GW1. R1.7's rollover cutover
  /// hits exactly this window (found in R1.4, 2026-07-23). A completed season
  /// (the 25/26 archive) carries real values; a fresh 26/27 does not yet.
  strength            Int?
  strengthOverallHome Int?
  strengthOverallAway Int?
  strengthAttackHome  Int?
  strengthAttackAway  Int?
  strengthDefenceHome Int?
  strengthDefenceAway Int?

  season        Season         @relation(fields: [seasonId], references: [id])
  club          Club           @relation(fields: [clubId], references: [id])
  playerSeasons PlayerSeason[]
  homeFixtures  Fixture[]      @relation("homeFixtures")
  awayFixtures  Fixture[]      @relation("awayFixtures")
  asset         Asset?

  @@unique([seasonId, clubId])
  @@unique([seasonId, fplId])
  @@map("club_season")
}

/// A footballer's cross-season identity (renamed from `FplPlayer` in R5.7).
model Player {
  id         Int       @id @default(autoincrement())
  /// `element.code` — stable across seasons, unlike `element.id`.
  fplCode    Int       @unique
  /// `element.opta_code`, e.g. "p118748".
  optaCode   String?   @unique
  firstName  String
  secondName String
  webName    String
  birthDate  DateTime? @db.Date

  seasons  PlayerSeason[]
  comments Comment[]

  @@map("player")
}

/// A footballer's registration in one season: which club, which position, and
/// the availability signals the valuation engine reads (R3.4).
model PlayerSeason {
  id           Int @id @default(autoincrement())
  seasonId     Int
  playerId     Int
  clubSeasonId Int
  /// `element.id` — season-scoped. This is the key `event/{gw}/live` uses, so
  /// (seasonId, fplId) is how R1.4 resolves a live element to a footballer.
  fplId        Int

  position PlayerPosition

  /// FPL availability code: a=available, d=doubtful, i=injured, s=suspended,
  /// u=unavailable, n=not in squad.
  status                   String
  chanceOfPlayingThisRound Int?
  chanceOfPlayingNextRound Int?
  news                     String
  newsAddedAt              DateTime?

  squadNumber  Int?
  teamJoinDate DateTime? @db.Date

  /// FPL's own price, in tenths of a million. Not our price — an input.
  nowCost           Int
  selectedByPercent Decimal @db.Decimal(6, 3)

  season     Season     @relation(fields: [seasonId], references: [id])
  player     Player     @relation(fields: [playerId], references: [id])
  clubSeason ClubSeason @relation(fields: [clubSeasonId], references: [id])

  fixtureStats  PlayerFixtureStat[]
  gameweekStats PlayerGameweekStat[]
  seasonStat    PlayerSeasonStat?
  asset         Asset?

  @@unique([seasonId, playerId])
  @@unique([seasonId, fplId])
  @@index([clubSeasonId])
  @@map("player_season")
}

model Gameweek {
  id       Int @id @default(autoincrement())
  seasonId Int
  /// `event.id` — 1..38 within the season.
  number   Int

  name         String
  /// Null on unscheduled events; FPL leaves it unset before a season is fixed.
  deadlineTime DateTime?
  finished     Boolean
  /// FPL's own signal that bonus points are final. R6.4 settles on this.
  dataChecked  Boolean
  isPrevious   Boolean
  isCurrent    Boolean
  isNext       Boolean

  averageEntryScore Int?
  highestScore      Int?
  /// Timestamp when R6.4 settled this gameweek.
  settledAt         DateTime?

  season              Season               @relation(fields: [seasonId], references: [id])
  fixtures            Fixture[]
  playerFixtureStats  PlayerFixtureStat[]
  playerGameweekStats PlayerGameweekStat[]
  fairValues          FairValue[]

  @@unique([seasonId, number])
  @@map("gameweek")
}

/// One match. Written by the fixtures ingest (R1.3) and the row that
/// `player_fixture_stat` hangs off in R1.4.
model Fixture {
  id         Int  @id @default(autoincrement())
  seasonId   Int
  /// Null until FPL schedules the match into a gameweek. Postponements land
  /// here too, and the whole calendar sits null before a season is published.
  gameweekId Int?

  /// `fixture.id` — season-scoped, 1..380, and the key `explain[].fixture`
  /// carries in event/{gw}/live. This is how R1.4 attributes a stat line.
  fplId Int
  /// `fixture.code` — a Premier League match code, believed globally unique
  /// rather than season-scoped.
  code  Int @unique

  homeClubSeasonId Int
  awayClubSeasonId Int

  kickoffTime          DateTime?
  /// FPL leaves this null before it has decided a match has begun.
  started              Boolean?
  finished             Boolean
  /// Set when the match ends but bonus points are not yet final.
  finishedProvisional  Boolean
  provisionalStartTime Boolean
  minutes              Int

  homeScore      Int?
  awayScore      Int?
  /// FPL's own 1–5 difficulty ratings. An input to R7.1's odds, not a judgement.
  homeDifficulty Int
  awayDifficulty Int

  season   Season     @relation(fields: [seasonId], references: [id])
  gameweek Gameweek?  @relation(fields: [gameweekId], references: [id])
  homeClub ClubSeason @relation("homeFixtures", fields: [homeClubSeasonId], references: [id])
  awayClub ClubSeason @relation("awayFixtures", fields: [awayClubSeasonId], references: [id])

  playerStats PlayerFixtureStat[]
  predictions Prediction[]

  @@unique([seasonId, fplId])
  @@index([gameweekId])
  @@index([kickoffTime])
  @@index([homeClubSeasonId])
  @@index([awayClubSeasonId])
  @@map("fixture")
}

/// Per-fixture player stats, split out of `event/{gw}/live`'s `explain` block.
model PlayerFixtureStat {
  id             Int @id @default(autoincrement())
  playerSeasonId Int
  fixtureId      Int
  gameweekId     Int

  minutes               Int
  goalsScored           Int
  assists               Int
  cleanSheets           Int
  goalsConceded         Int
  ownGoals              Int
  penaltiesSaved        Int
  penaltiesMissed       Int
  yellowCards           Int
  redCards              Int
  saves                 Int
  bonus                 Int
  defensiveContribution Int
  totalPoints           Int

  playerSeason PlayerSeason @relation(fields: [playerSeasonId], references: [id])
  fixture      Fixture      @relation(fields: [fixtureId], references: [id])
  gameweek     Gameweek     @relation(fields: [gameweekId], references: [id])

  @@unique([playerSeasonId, fixtureId])
  @@index([fixtureId])
  @@index([gameweekId])
  @@map("player_fixture_stat")
}

/// Per-gameweek player totals, taken verbatim from `event/{gw}/live`'s `stats`
/// block.
model PlayerGameweekStat {
  id             Int @id @default(autoincrement())
  playerSeasonId Int
  gameweekId     Int

  minutes                       Int
  starts                        Int
  goalsScored                   Int
  assists                       Int
  cleanSheets                   Int
  goalsConceded                 Int
  ownGoals                      Int
  penaltiesSaved                Int
  penaltiesMissed               Int
  yellowCards                   Int
  redCards                      Int
  saves                         Int
  bonus                         Int
  bps                           Int
  tackles                       Int
  recoveries                    Int
  clearancesBlocksInterceptions Int
  defensiveContribution         Int

  influence                Decimal @db.Decimal(10, 2)
  creativity               Decimal @db.Decimal(10, 2)
  threat                   Decimal @db.Decimal(10, 2)
  ictIndex                 Decimal @db.Decimal(10, 2)
  expectedGoals            Decimal @db.Decimal(8, 2)
  expectedAssists          Decimal @db.Decimal(8, 2)
  expectedGoalInvolvements Decimal @db.Decimal(8, 2)
  expectedGoalsConceded    Decimal @db.Decimal(8, 2)

  totalPoints Int

  playerSeason PlayerSeason @relation(fields: [playerSeasonId], references: [id])
  gameweek     Gameweek     @relation(fields: [gameweekId], references: [id])
  @@unique([playerSeasonId, gameweekId])
  @@index([gameweekId])
  @@map("player_gameweek_stat")
}

/// Archived FPL responses, so any parse can be replayed without refetching.
model RawPayload {
  id       Int    @id @default(autoincrement())
  endpoint String
  scopeKey String

  url       String
  status    Int
  fetchedAt DateTime
  bytes     Int
  attempts  Int
  bodyHash  String
  body      Json

  @@unique([endpoint, scopeKey])
  @@map("raw_payload")
}

/// Season-to-date aggregates for one player, recomputed from the immutable
/// per-fixture and per-gameweek rows (R2.3), never incremented. Invariant 4: a
/// recompute reproduces this row exactly.
model PlayerSeasonStat {
  id             Int @id @default(autoincrement())
  playerSeasonId Int @unique

  appearances Int
  minutes     Int
  starts      Int

  goalsScored           Int
  assists               Int
  cleanSheets           Int
  goalsConceded         Int
  ownGoals              Int
  penaltiesSaved        Int
  penaltiesMissed       Int
  yellowCards           Int
  redCards              Int
  saves                 Int
  bonus                 Int
  defensiveContribution Int
  totalPoints           Int

  bps                           Int
  tackles                       Int
  recoveries                    Int
  clearancesBlocksInterceptions Int

  influence                Decimal @db.Decimal(10, 2)
  creativity               Decimal @db.Decimal(10, 2)
  threat                   Decimal @db.Decimal(10, 2)
  ictIndex                 Decimal @db.Decimal(10, 2)
  expectedGoals            Decimal @db.Decimal(10, 2)
  expectedAssists          Decimal @db.Decimal(10, 2)
  expectedGoalInvolvements Decimal @db.Decimal(10, 2)
  expectedGoalsConceded    Decimal @db.Decimal(10, 2)

  computedAt DateTime @default(now())

  playerSeason PlayerSeason @relation(fields: [playerSeasonId], references: [id])

  @@map("player_season_stat")
}

enum AssetKind {
  PLAYER
  CLUB
}

/// One tradeable instrument — a player or a club, in a given season.
model Asset {
  id   Int       @id @default(autoincrement())
  kind AssetKind

  playerSeasonId Int? @unique
  clubSeasonId   Int? @unique

  inventory     Int     @default(0)
  seedInventory Int     @default(0)
  liquidity     Decimal @default(1) @db.Decimal(18, 6)

  playerSeason PlayerSeason? @relation(fields: [playerSeasonId], references: [id])
  clubSeason   ClubSeason?   @relation(fields: [clubSeasonId], references: [id])

  fairValues FairValue[]
  priceTicks PriceTick[]
  positions  Position[]
  trades     Trade[]

  @@index([kind])
  @@map("asset")
}

enum FairValueSource {
  GAMEWEEK
  AVAILABILITY
  SEED
}

/// A fair-value observation for an asset: what the football says it's worth,
/// independent of market demand.
model FairValue {
  id      Int @id @default(autoincrement())
  assetId Int

  gameweekId Int?
  source     FairValueSource

  value Decimal @db.Decimal(12, 4)

  baseline         Decimal? @db.Decimal(12, 6)
  form             Decimal? @db.Decimal(12, 6)
  availabilityMult Decimal? @db.Decimal(6, 4)
  positionBase     Decimal? @db.Decimal(12, 4)

  computedAt DateTime @default(now())

  asset    Asset     @relation(fields: [assetId], references: [id])
  gameweek Gameweek? @relation(fields: [gameweekId], references: [id])

  @@index([assetId, computedAt])
  @@index([gameweekId])
  @@map("fair_value")
}

enum TradeSide {
  BUY
  SELL
}

/// A filled trade against the AMM.
model Trade {
  id      Int       @id @default(autoincrement())
  userId  String
  assetId Int
  side    TradeSide

  shares         Int
  avgPrice       Decimal @db.Decimal(12, 4)
  grossCost      BigInt
  fee            BigInt
  inventoryAfter Int

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  asset Asset @relation(fields: [assetId], references: [id])

  priceTick     PriceTick?
  ledgerEntries LedgerEntry[]

  @@index([userId, createdAt])
  @@index([assetId, createdAt])
  @@map("trade")
}

enum PriceTickSource {
  TRADE
  VALUATION
}

/// Market price history. One row per price-moving event.
model PriceTick {
  id      Int @id @default(autoincrement())
  assetId Int

  source  PriceTickSource
  tradeId Int?            @unique

  price     Decimal @db.Decimal(12, 4)
  fairValue Decimal @db.Decimal(12, 4)
  inventory Int

  computedAt DateTime @default(now())

  asset Asset  @relation(fields: [assetId], references: [id])
  trade Trade? @relation(fields: [tradeId], references: [id])

  @@index([assetId, computedAt])
  @@map("price_tick")
}

/// A user's holding in one asset.
model Position {
  id      Int    @id @default(autoincrement())
  userId  String
  assetId Int

  shares  Int
  avgCost Decimal @db.Decimal(12, 4)

  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  asset Asset @relation(fields: [assetId], references: [id])

  @@unique([userId, assetId])
  @@index([assetId])
  @@map("position")
}

enum LedgerAccount {
  USER_CASH
  AMM_LIQUIDITY
  FEE_SINK
  MINT
}

enum LedgerReason {
  TRADE_BUY
  TRADE_SELL
  TRADE_FEE
  COIN_GRANT
  QUEST_REWARD
  PREDICTION_STAKE
  PREDICTION_PAYOUT
}

/// Double-entry ledger (R4.2).
model LedgerEntry {
  id      Int           @id @default(autoincrement())
  userId  String?
  account LedgerAccount
  reason  LedgerReason

  amount BigInt

  transferId String
  tradeId    Int?

  createdAt DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id])
  trade Trade? @relation(fields: [tradeId], references: [id])

  @@index([userId, createdAt])
  @@index([transferId])
  @@index([account, createdAt])
  @@map("ledger_entry")
}
